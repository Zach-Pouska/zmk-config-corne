#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&led_strip { chain-length = <27>; };

/ {
    combos {
        compatible = "zmk,combos";

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 35>;
        };

        goto-alt-layer {
            bindings = <&tog 5>;
            key-positions = <37 40>;
            layers = <0 3 4>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <11 10>;
        };

        f1 {
            bindings = <&kp F1>;
            key-positions = <1 0>;
            require-prior-idle-ms = <400>;
        };

        f2 {
            bindings = <&kp F2>;
            key-positions = <1 2>;
            require-prior-idle-ms = <400>;
        };

        f3 {
            bindings = <&kp F3>;
            key-positions = <2 3>;
            require-prior-idle-ms = <400>;
        };

        f4 {
            bindings = <&kp F4>;
            key-positions = <3 4>;
            require-prior-idle-ms = <400>;
        };

        f5 {
            bindings = <&kp F5>;
            key-positions = <5 4>;
            require-prior-idle-ms = <400>;
        };

        f6 {
            bindings = <&kp F6>;
            key-positions = <6 7>;
            require-prior-idle-ms = <400>;
        };

        f7 {
            bindings = <&kp F7>;
            key-positions = <6 8>;
            require-prior-idle-ms = <400>;
        };

        f8 {
            bindings = <&kp F8>;
            key-positions = <6 9>;
            require-prior-idle-ms = <400>;
        };

        f9 {
            bindings = <&kp F9>;
            key-positions = <6 10>;
            require-prior-idle-ms = <400>;
        };

        f12 {
            bindings = <&kp F12>;
            key-positions = <10 9>;
            require-prior-idle-ms = <400>;
        };

        f11 {
            bindings = <&kp F11>;
            key-positions = <9 8>;
            require-prior-idle-ms = <400>;
        };

        f10 {
            bindings = <&kp F10>;
            key-positions = <8 8 7>;
            require-prior-idle-ms = <400>;
        };

        exit-game-layer {
            bindings = <&tog 0>;
            key-positions = <37 40>;
            layers = <6>;
        };

        game-layer-esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };
    };

    behaviors {
        tap_escape_hold_ctrl: tap_escape_hold_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_ESCAPE_HOLD_CTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
        };

        bkspcShiftDelForward: bkspcShiftDelForward {
            compatible = "zmk,behavior-mod-morph";
            label = "BKSPCSHIFTDELFORWARD";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        layer_hold_tap: layer_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD_TAP";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <120>;
            flavor = "hold-preferred";
        };

        mouse_move_2speed: mouse_move_2speed {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_MOVE_2SPEED";
            bindings = <&mmv>, <&mmv>;

            #binding-cells = <2>;
            tapping-term-ms = <50>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB                                    &kp Q  &kp W  &kp E         &kp R  &kp T        &kp Y    &kp U  &kp I         &kp O    &kp P     &kp BACKSPACE
&tap_escape_hold_ctrl LEFT_CONTROL ESCAPE  &kp A  &kp S  &kp D         &kp F  &kp G        &kp H    &kp J  &kp K         &kp L    &kp SEMI  &kp SQT
&kp LSHFT                                  &kp Z  &kp X  &kp C         &kp V  &kp B        &kp N    &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                                         &kp LEFT_ALT  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp LEFT_WIN
            >;
        };

        lower_layer {
            display-name = "LOW";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp N1  &kp N2  &kp N3    &kp N4   &kp N5           &kp N6     &kp N7     &kp N8            &kp N9             &kp N0         &trans
&trans  &trans  &trans  &kp C_PP  &trans   &kp PAGE_UP      &kp LEFT   &kp DOWN   &kp UP            &kp RIGHT          &kp BACKSLASH  &trans
&trans  &trans  &trans  &kp HOME  &kp END  &kp PAGE_DOWN    &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PIPE       &trans
                        &trans    &trans   &kp SPACE        &kp RET    &trans     &trans
            >;
        };

        raise_layer {
            display-name = "RAI";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp GRAVE   &trans           &trans    &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC    &kp C_PREV  &kp C_NEXT  &kp C_MUTE        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&trans  &kp INSERT  &kp PRINTSCREEN  &kp C_PP  &kp KP_NUMLOCK        &kp PAGE_UP             &kp LEFT    &kp DOWN    &kp UP_ARROW      &kp RIGHT          &kp BSLH         &trans
&trans  &trans      &trans           &kp HOME  &kp END               &kp PAGE_DOWN           &kp MINUS   &kp EQUAL   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PIPE         &trans
                                     &trans    &trans                &trans                  &trans      &trans      &trans
            >;
        };

        mouse-nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans               &trans    &mkp MB4                                   &mkp LCLK                                 &mkp MCLK                                &mkp RCLK                                  &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans               &trans    &mouse_move_2speed MOVE_LEFT MOVE_X(-600)  &mouse_move_2speed MOVE_Y(600) MOVE_DOWN  &mouse_move_2speed MOVE_Y(-600) MOVE_UP  &mouse_move_2speed MOVE_X(600) MOVE_RIGHT  &trans    &trans
&trans  &trans  &trans  &trans  &trans               &trans    &msc SCRL_LEFT                             &msc SCRL_DOWN                            &msc SCRL_UP                             &msc SCRL_RIGHT                            &trans    &trans
                        &trans  &layer_hold_tap 1 0  &trans    &trans                                     &layer_hold_tap 2 0                       &trans
            >;

            label = "M/N";
        };

        NUMPAD+FN {
            bindings = <
&trans  &kp F15  &kp F7  &kp F8  &kp F9               &kp F12    &kp KP_PLUS  &kp N7               &kp N8  &kp N9  &trans    &trans
&trans  &kp F14  &kp F4  &kp F5  &kp F6               &kp F11    &kp N0       &kp N4               &kp N5  &kp N6  &kp STAR  &trans
&trans  &kp F13  &kp F1  &kp F2  &kp F3               &kp F10    &kp MINUS    &kp N1               &kp N2  &kp N3  &trans    &trans
                         &trans  &layer_hold_tap 1 0  &trans     &trans       &layer_hold_tap 2 0  &trans
            >;

            label = "NFN";
        };

        ALT-HUB {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &studio_unlock  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans          &trans  &trans  &trans  &trans
&trans  &trans        &bt BT_CLR    &trans        &trans        &trans          &trans  &trans          &trans  &trans  &trans  &trans
                                    &trans        &to 4         &trans          &trans  &to 3           &trans
            >;

            label = "AHUB";
        };

        gaming {
            bindings = <
&trans            &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_CONTROL  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans            &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "GAME";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
